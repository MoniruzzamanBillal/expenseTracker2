{
  "expo": {
    "name": "xpns",
    "slug": "xpns",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "xpns",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.xpns.app"
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
